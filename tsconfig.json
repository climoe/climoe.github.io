{
  "compilerOptions": {
    "target": "es6",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/styles/*": [
        "./src/styles/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/content/*": [
        "./src/content/*"
      ],
      "@/public/*": [
        "./src/public/*"
      ]
    },
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "mdx": {
    "plugins": [
      "remark-frontmatter",
      "remark-frontmatter-mdx",
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "./src/types/*",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mdx",
    ""

  ],
  "exclude": [
    "node_modules"
  ]
}
